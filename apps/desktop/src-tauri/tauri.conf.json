{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dango",
  "version": "0.1.1",
  "identifier": "com.leapstark.dango",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:production",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dango",
        "width": 920,
        "height": 680,
        "minWidth": 620,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 https://dango.marcio.run; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "dmg": {
        "background": "./images/installer.png"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
