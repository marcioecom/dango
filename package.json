{
  "name": "dango",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "turbo build",
    "check": "turbo check",
    "db:migrate": "pnpm --filter @dango/web db:migrate",
    "db:up": "docker compose up -d postgres",
    "dev": "turbo dev",
    "dev:desktop": "pnpm --filter @dango/desktop tauri dev",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.10.5"
  }
}
